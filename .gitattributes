# The device runs BusyBox ash on Linux 2.6.24. A shell script checked out with
# CRLF fails there with a bare `\r: not found`, so pin LF for everything textual
# regardless of the cloner's core.autocrlf. This matters most for flash/sata/*.sh
# and flash/device/*.sh, which are uploaded to the DVR verbatim.
* text=auto eol=lf

*.sh   text eol=lf
*.c    text eol=lf
*.h    text eol=lf
*.S    text eol=lf
*.py   text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.conf text eol=lf

*.bin  binary
*.png  binary
*.jpg  binary
*.gz   binary
*.tgz  binary
*.pdf  binary
*.ext2 binary
*.out  binary
*.ko   binary
*.dll  binary
